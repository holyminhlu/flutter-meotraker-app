PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# PostgreSQL — cách 1: các biến rời (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meo_traker
DB_USER=postgres
DB_PASSWORD=your_password_here

# PostgreSQL — cách 2: connection string (Aiven/Render). Nếu đặt, sẽ ưu tiên.
# DATABASE_URL=postgres://user:pass@host:port/dbname?sslmode=require

# Bật SSL cho DB (tự bật khi NODE_ENV=production hoặc có DATABASE_URL).
# DB_SSL=true

# Tùy chọn: dán nội dung ca.pem của Aiven để xác thực CA đầy đủ.
# Không đặt thì vẫn mã hóa TLS nhưng bỏ qua kiểm tra CA.
# DB_CA_CERT=

# Thư mục lưu ảnh bữa ăn. Trên Render trỏ vào Persistent Disk, vd /var/data/uploads
# UPLOADS_DIR=

# Gemini — nhận diện thức ăn trong ảnh bữa ăn
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MEAL_MODEL=gemini-3.5-flash-lite

# OpenRouter — chatbot Meo AI (Mimo v2.5)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=xiaomi/mimo-v2.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://meo-traker.local
OPENROUTER_SITE_NAME=Meo Traker
