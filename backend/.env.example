PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meo_traker
DB_USER=postgres
DB_PASSWORD=your_password_here

# Gemini — nhận diện thức ăn trong ảnh bữa ăn
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MEAL_MODEL=gemini-3.5-flash-lite
